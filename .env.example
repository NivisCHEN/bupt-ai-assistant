# BUPT AI Campus Assistant - Environment Configuration
# Copy this file to .env and fill in your values

# LLM Configuration
BUPT_LLM__API_KEY=your-api-key-here
BUPT_LLM__BASE_URL=https://api.deepseek.com
BUPT_LLM__MODEL_NAME=deepseek-chat
BUPT_LLM__TEMPERATURE=0.7
BUPT_LLM__MAX_TOKENS=2048

# Embedding Configuration
BUPT_EMBEDDING__MODEL_NAME=BAAI/bge-small-zh-v1.5
BUPT_EMBEDDING__DEVICE=cpu

# Application
BUPT_APP__DEBUG=true
BUPT_APP__HOST=0.0.0.0
BUPT_APP__PORT=8000

# Authentication
ADMIN_API_KEY=change-me-to-a-secure-random-string

# CORS (comma-separated origins, default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# Redis (optional, for session caching)
BUPT_REDIS__HOST=localhost
BUPT_REDIS__PORT=6379
BUPT_REDIS__DB=0
